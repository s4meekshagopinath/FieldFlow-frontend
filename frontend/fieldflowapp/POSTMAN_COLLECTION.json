{
  "info": {
    "name": "FieldFlow SaaS API Collection",
    "description": "Complete Postman collection for testing FieldFlow backend endpoints (Auth, Settings, Admin, Bookings, Technicians).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"customer\",\n  \"name\": \"Ananya Sharma\",\n  \"email\": \"ananya.test@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"password123\",\n  \"city\": \"Bangalore\",\n  \"address\": \"100 Feet Road, Indiranagar\",\n  \"pincode\": \"560038\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Settings & Preferences",
      "item": [
        {
          "name": "Get User Preferences",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/settings/preferences",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "settings", "preferences"]
            }
          }
        },
        {
          "name": "Update Appearance (Theme)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"theme\": \"light\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/settings/appearance",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "settings", "appearance"]
            }
          }
        },
        {
          "name": "Update Notifications",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_notifications\": true,\n  \"push_notifications\": false,\n  \"marketing_notifications\": true\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/settings/notifications",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "settings", "notifications"]
            }
          }
        },
        {
          "name": "Update Language Preference",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"hi\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/settings/language",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "settings", "language"]
            }
          }
        },
        {
          "name": "Update Privacy Settings",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"privacy_profile_visibility\": \"public\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/settings/privacy",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "settings", "privacy"]
            }
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newpassword456\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/settings/password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "settings", "password"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ananya Sharma\",\n  \"phone\": \"9876543210\",\n  \"city\": \"Mumbai\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/settings/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "settings", "profile"]
            }
          }
        }
      ]
    },
    {
